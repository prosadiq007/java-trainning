import java.util.Scanner;

public class main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int a,d,even=0,odd=0;
        a=sc.nextInt();
        while(a!=0){
            d=a%10;
            if(d%2==0){
                even++;
                a=a/10;
            }else{
                odd++;
                a=a/10;
            }
        }
        System.out.println("Odd : " + odd);
        System.out.println("Even : " + even);
    }
}
