import java.util.*;
public class Main
{
    public static void main(String[] args)
    {
        String a="HEllo12?";
        int upper=0,lower=0,chare=0,num=0;
        for (int i =0;i<a.length();i++)
        {
            char b=a.charAt(i);
            if(Character.isUpperCase(b))
            {
                upper++;
            }
            else if(Character.isLowerCase(b))
            {
                lower++;
            }
            else if(Character.isDigit(b))
            {
                num++;
            }
            else
            {
                chare++;
            }
        }
        System.out.println("No of Upper case "+upper);
        System.out.println("No of Lower case "+lower);
        System.out.println("No of Digits "+num);
        System.out.println("No of special char "+chare);
    }
}
