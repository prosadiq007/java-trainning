import java.util.*;
public class Main
{
    public static void main(String[] args)
    {
        int [][]b={{2,4,5},{3,4,5},{6,7,8}};
        int r=b.length;
        int c=b[0].length;
        int []a=new int[r*c];
        int x=0;
        
        for(int i=0;i<r;i++)
        {
            for(int j=0;j<c;j++)
            {
                a[x]=b[i][j];
                x++;
            }
        }
        System.out.println(Arrays.toString(a));
    }
}
