import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner sc=new Scanner(System.in);
        String []names=new String[5];
        int []marks=new int[5];
        int s=1;
        
        for(int i=0;i<5;i++)
        {
            System.out.println(" Enter the mark & name of student :");
            marks[i]=sc.nextInt();
            sc.next();
            names[i]=sc.nextLine();
            
        }
        for(int i=0;i<5;i++){
        if(marks[i]>50){
            System.out.println(s+" "+names[i]+"has scored marks "+marks[i]);
            s++;
            }
        }
    }
}
